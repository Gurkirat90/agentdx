# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# tests/acceptance/'s per-gate run output (tests/acceptance/test_gates.py) -- transient,
# regenerated by every `just acceptance` run, never a source of truth.
tests/acceptance/.results/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.hypothesis/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
# Vite/Vitest's own transient config-bundling artifacts -- written to frontend/ root when either
# tool needs to bundle the ESM config file, normally auto-cleaned but can leak in some sandboxes.
frontend/vite.config.ts.timestamp-*.mjs
frontend/vitest.config.ts.timestamp-*.mjs
# Playwright's own run artifacts (traces, screenshots) -- G8 output, never a source of truth.
# NB: git does NOT support trailing comments on a pattern line -- the whole line, spaces and
# all, is the pattern. Both entries below carried one from 2026-08-27 (commit bde03c9) until
# 2026-08-29, so neither directory was ever actually ignored despite that commit saying so.
frontend/test-results/
frontend/playwright-report/
# built frontend, copied in at package time (PRD §39.4)
src/agentdx/api/static/

# AgentDX runtime data (PRD §39.1) — never committed
.agentdx-data/
*.agentdx
runs.db
runs.db-wal
runs.db-shm
metrics.jsonl

# Event/cache databases are generated, EXCEPT the committed fixture caches that
# make the offline demo work (PRD §38.2, §39.4) — those are force-added.
*.db
*.db-wal
*.db-shm
!fixtures/*/cache/*.db

# CI output
ci-out/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Cross-session transfer artifacts — never real project content
_incoming/
_to_delete/
*.tar.gz
