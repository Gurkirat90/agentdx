{
  "name": "agentdx-control-tower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AgentDX Control Tower — CONTEXT.md §3 locks React 18 + Vite + TypeScript + React Flow + Zustand + Tailwind + visx",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test tests/frontend/e2e/perf.spec.ts",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.ts && node scripts/patch-schema-jsonvalue.mjs",
    "check:hex-literals": "node scripts/check-hex-literals.mjs",
    "gen:fixtures": "node scripts/gen-perf-fixture.mjs"
  },
  "dependencies": {
    "@visx/axis": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@xyflow/react": "^12.3.5",
    "openapi-fetch": "^0.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
